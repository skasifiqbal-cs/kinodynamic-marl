# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
/env/

# Per-person experiment selection. Everyone edits this instead of conf/config.yaml, so
# two people running different experiments never conflict in a tracked file. The
# committed template next to it (local.yaml.example) is what a new clone copies.
conf/experiment/local.yaml

# Hydra outputs
outputs/
multirun/
.hydra/

# Training runs: weights and tensorboard logs stay out of git (they are permanent once
# committed, and a full-length run writes ~18 MB of checkpoints). Curves and the best
# policy go to W&B instead — `train.py ... wandb.enabled=true` publishes an artifact.
# The per-run config.yaml IS tracked: it is 4 KB and it is the record of what was run,
# so a collaborator's results are reviewable in the diff.
runs/*
!runs/*/
runs/*/*
!runs/*/*/
runs/*/*/*
!runs/*/*/config.yaml

# Weights & Biases
wandb/

# Checkpoints and artifacts
*.pt
*.pth
*.ckpt
episode.gif
*.gif

# Jupyter
.ipynb_checkpoints/

# Local notes (not tracked)
notes/

# OS
.DS_Store
*.swp

# IDE
.vscode/
.idea/

# Claude local
.claude/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# graphify knowledge graph (generated)
graphify-out/

# Diagnostic sweep outputs (regenerate with scripts/, not tracked)
experiments/

# Compiled paper (build from paper/*.tex)
paper/*.pdf
